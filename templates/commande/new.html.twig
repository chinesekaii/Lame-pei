{% extends 'base.html.twig' %}

{% block title %}Commande · L'ÂME PEÏ{% endblock %}

{% block body %}
    <section class="page">
        <div class="page__entete">
            <div class="surtitre">Dernière étape</div>
            <h1 class="titre-section">Livraison</h1>
            <p>Livraison en main propre partout à La Réunion, sous {{ constant('App\\Enum\\SecteurLivraison::DELAI') }}.</p>
        </div>

        {# Le contrôleur Stimulus « livraison » met à jour les frais et le total quand on change de commune #}
        <div class="commande__grille" data-controller="livraison" data-livraison-sous-total-value="{{ panier.total }}">
            <div class="carte-formulaire">
                {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
                    {{ form_row(form.nomComplet) }}
                    {{ form_row(form.adresse) }}
                    {{ form_row(form.complement) }}
                    <div class="form-duo">
                        {{ form_row(form.codePostal) }}
                        {{ form_row(form.commune) }}
                    </div>
                    {{ form_row(form.telephone) }}

                    <div class="form-ligne{{ form.accepteCgv.vars.errors|length ? ' form-ligne--erreur' }}">
                        <label class="case case--cgv">
                            {{ form_widget(form.accepteCgv) }}
                            <span>J'ai lu et j'accepte les <a href="{{ path('app_cgv') }}" target="_blank" rel="noopener">conditions générales de vente</a>.</span>
                        </label>
                        {{ form_errors(form.accepteCgv) }}
                    </div>

                    <button type="submit" class="btn btn--plein btn--large">
                        Valider et payer par carte · <span data-livraison-target="totalBouton">{{ (panier.total + form.vars.value.fraisLivraison)|prix }}</span>
                    </button>
                    <p class="recap__note recap__note--centre">Paiement sécurisé par Stripe. Vous serez redirigé(e) vers sa page de paiement.</p>
                {{ form_end(form) }}
            </div>

            <aside class="commande__recap">
                <div class="surtitre">Récapitulatif</div>
                <ul class="mini-recap">
                    {% for ligne in panier.lignes %}
                        <li>
                            <span>
                                <span class="mini-recap__nom" style="color: {{ ligne.modele.couleur ?? '#8C3A1E' }}">{{ ligne.modele.nom }}</span>
                                Taille {{ ligne.variante.taille }}{{ ligne.quantite > 1 ? ' × ' ~ ligne.quantite }}
                            </span>
                            <span>{{ ligne.sousTotal|prix }}</span>
                        </li>
                    {% endfor %}
                    <li class="mini-recap__livraison">
                        <span>Livraison <span data-livraison-target="secteur">{{ form.vars.value.secteur ? '(' ~ form.vars.value.secteur.label ~ ')' }}</span></span>
                        <span data-livraison-target="frais">
                            {%- if form.vars.value.secteur is null -%}
                                selon la commune
                            {%- elseif form.vars.value.fraisLivraison == 0 -%}
                                offerte
                            {%- else -%}
                                {{ form.vars.value.fraisLivraison|prix }}
                            {%- endif -%}
                        </span>
                    </li>
                </ul>
                <div class="recap__total recap__total--petit">
                    <span>Total</span><span data-livraison-target="total">{{ (panier.total + form.vars.value.fraisLivraison)|prix }}</span>
                </div>

                <table class="tarifs-livraison">
                    <caption>Tarifs de livraison</caption>
                    <tbody>
                        <tr><th scope="row">Ouest</th><td>offerte</td></tr>
                        <tr><th scope="row">Nord</th><td>5 €</td></tr>
                        <tr><th scope="row">Sud et Est</th><td>8 €</td></tr>
                    </tbody>
                </table>

                <p class="recap__note">Commande au nom de {{ app.user }} ({{ app.user.email }}).</p>
                <a href="{{ path('app_panier_index') }}" class="lien-discret">Modifier le panier</a>
            </aside>
        </div>
    </section>
{% endblock %}
