<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}L'ÂME PEÏ · Tongs perlées fait main à La Réunion{% endblock %}</title>
        <meta name="description" content="{% block meta_description %}Tongs Havaianas brodées à la main, perle après perle, à La Réunion. Pièces uniques, tailles 36 à 42.{% endblock %}">
        <link rel="icon" type="image/png" href="{{ asset('images/logo.png') }}">

        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">

        {% block stylesheets %}{% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    {# Le tiroir s'ouvre tout seul juste après un ajout au panier #}
    <body data-controller="panier" data-panier-ouvert-value="{{ app.flashes('ouvrir_panier') is not empty ? 'true' : 'false' }}">
        <div class="site">
            {{ include('partials/_header.html.twig') }}

            {{ include('partials/_flash.html.twig') }}

            <main>
                {% block body %}{% endblock %}
            </main>

            {{ include('partials/_footer.html.twig') }}
        </div>

        {{ include('partials/_panier.html.twig') }}
    </body>
</html>
