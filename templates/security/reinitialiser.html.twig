{% extends 'base.html.twig' %}

{% block title %}Nouveau mot de passe · L'ÂME PEÏ{% endblock %}

{% block body %}
    <section class="page page--etroite">
        <div class="page__entete">
            <div class="surtitre">Espace client</div>
            <h1 class="titre-section">Nouveau mot de passe</h1>
        </div>

        <div class="carte-formulaire">
            {# action vide : le formulaire est renvoyé à la même adresse signée #}
            {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
                {{ form_row(form.nouveau.first) }}
                {{ form_row(form.nouveau.second) }}
                <button type="submit" class="btn btn--plein btn--large">Enregistrer</button>
            {{ form_end(form) }}
        </div>
    </section>
{% endblock %}
