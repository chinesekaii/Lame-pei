{% extends 'base.html.twig' %}

{% block title %}Connexion · L'ÂME PEÏ{% endblock %}

{% block body %}
    <section class="page page--etroite">
        <div class="page__entete">
            <div class="surtitre">Espace client</div>
            <h1 class="titre-section">Connexion</h1>
        </div>

        {% if app.user %}
            <div class="flash flash--integre carte-connecte">
                Vous êtes connecté(e) avec <strong>{{ app.user.email }}</strong>.
                {% if is_granted('ROLE_ADMIN') %}
                    <a href="{{ path('admin') }}">Aller à l'administration</a> ·
                {% endif %}
                <a href="{{ path('app_compte') }}">Mon compte</a> ·
                <a href="{{ path('app_logout') }}">Se déconnecter</a>
                <br><small>Pour utiliser un autre compte, connectez-vous ci-dessous.</small>
            </div>
        {% endif %}

        <div class="carte-formulaire">
            {% if erreur %}
                <ul class="form-erreurs form-erreurs--bloc">
                    <li>{{ erreur.messageKey|trans(erreur.messageData, 'security') }}</li>
                </ul>
            {% endif %}

            <form method="post" action="{{ path('app_login') }}">
                <div class="form-ligne">
                    <label for="email" class="champ__label">Adresse e-mail</label>
                    <input type="email" id="email" name="email" value="{{ dernier_email }}" class="champ" autocomplete="email" required autofocus>
                </div>

                <div class="form-ligne">
                    <label for="password" class="champ__label">Mot de passe</label>
                    <input type="password" id="password" name="password" class="champ" autocomplete="current-password" required>
                </div>

                <label class="case">
                    <input type="checkbox" name="se_souvenir" value="1">
                    <span>Se souvenir de moi</span>
                </label>

                <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

                <button type="submit" class="btn btn--plein btn--large">Se connecter</button>
            </form>
        </div>

        <p class="page__bas">Pas encore de compte ? <a href="{{ path('app_inscription') }}">Créer un compte</a></p>
    </section>
{% endblock %}
