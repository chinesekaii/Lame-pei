{# Messages généraux. Les messages propres à une section (ex. « sur_mesure », « alerte ») sont affichés dans la section elle-même. #}
{% for type, messages in app.flashes(['success', 'error']) %}
    {% for message in messages %}
        <div class="flash flash--{{ type }}" role="status">{{ message }}</div>
    {% endfor %}
{% endfor %}
