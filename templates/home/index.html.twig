{% extends 'base.html.twig' %}

{% block body %}
    {# ───────── Accroche ───────── #}
    <section class="hero">
        <img src="{{ asset('images/hibiscus.png') }}" alt="" class="hibiscus hibiscus--hero-gauche">
        <img src="{{ asset('images/hibiscus.png') }}" alt="" class="hibiscus hibiscus--hero-droite">

        <div class="hero__contenu">
            <img src="{{ asset('images/logo.png') }}" alt="L'Âme Peï — fait main" class="hero__logo">
            <p class="hero__accroche">« Dans chaque pas, nana un bout nout île. »</p>
            <p class="hero__texte">
                L'ÂME PEÏ est une marque de savates artisanales, inspirée de notre île, de ses couleurs et de son identité réunionnaise.
                Chaque paire est brodée à la main, perle après perle.
            </p>
            <div class="hero__actions">
                <a href="#collections" class="btn btn--plein">Découvrir les collections</a>
                <a href="#commander" class="btn btn--contour">Sur-mesure</a>
            </div>
        </div>
    </section>

    {# ───────── Bandeau ───────── #}
    <div class="bandeau">
        <span>Fait main à La Réunion</span><span class="fleur">✿</span><span>Pièces uniques</span><span class="fleur">✿</span><span>Livraison partout à La Réunion</span>
    </div>

    {# ───────── Collections ───────── #}
    <div id="collections">
        {% for collection in collections %}
            {{ include('collection/_section.html.twig', {loop_index: loop.index0}) }}
        {% else %}
            <section class="section"><p class="vide">Les collections arrivent bientôt.</p></section>
        {% endfor %}
    </div>

    {# Modèles en vente rattachés à aucune collection (affiché seulement s'il y en a) #}
    {% if horsCollection is not empty %}
        <section class="section section--collection">
            <div class="section__entete">
                <h2 class="titre-section titre-section--moyen">Autres créations</h2>
            </div>
            <div class="grille-collection">
                {% for modele in horsCollection %}
                    {{ include('modele/_carte.html.twig') }}
                {% endfor %}
            </div>
        </section>
    {% endif %}

    {# ───────── En production (affiché seulement s'il y a des modèles en cours de broderie) ───────── #}
    {% if enProduction is not empty %}
        <section id="bientot" class="section section--bientot">
            <img src="{{ asset('images/hibiscus.png') }}" alt="" class="hibiscus hibiscus--bientot">

            <div class="section__entete">
                <div class="surtitre">En production</div>
                <h2 class="titre-section titre-section--moyen">Bientôt à l'atelier</h2>
                <p>Des modèles en cours de broderie. Dites-nous celui qui vous plaît : nous vous prévenons dès sa sortie.</p>
            </div>

            <div class="grille-bientot">
                {% for modele in enProduction %}
                    <a href="{{ path('app_modele_show', {slug: modele.slug}) }}" class="vignette">
                        <div class="vignette__image" style="background-image: url('{{ asset('uploads/modeles/' ~ modele.image) }}')" role="img" aria-label="Savates {{ modele.nom }}">
                            <span class="badge">En production</span>
                        </div>
                        <div class="vignette__nom" style="color: {{ modele.couleur ?? '#8C3A1E' }}">{{ modele.nom }}</div>
                    </a>
                {% endfor %}
            </div>
        </section>
    {% endif %}

    {# ───────── Savoir-faire ───────── #}
    <section id="savoirfaire" class="section savoir-faire">
        <div class="savoir-faire__grille">
            <div>
                <div class="savoir-faire__icone" style="color: #D8462A">✿</div>
                <h3>Brodé à la main</h3>
                <p>Chaque bride est cousue à l'aiguille sur une savate Havaianas, perle après perle, dans notre atelier de l'île.</p>
            </div>
            <div>
                <div class="savoir-faire__icone" style="color: #C79A3E">❍</div>
                <h3>Pièces uniques</h3>
                <p>Perles nacrées 6 mm, rocailles et perles dorées 2 mm, fil nylon résistant : deux paires ne sont jamais identiques.</p>
            </div>
            <div>
                <div class="savoir-faire__icone" style="color: #EE8A73">♡</div>
                <h3>L'âme péi</h3>
                <p>Hibiscus, bougainvilliers, terre volcanique : nos couleurs viennent des paysages de La Réunion.</p>
            </div>
        </div>
    </section>

    {# ───────── Sur-mesure ───────── #}
    <section id="commander" class="section section--commander">
        <img src="{{ asset('images/hibiscus.png') }}" alt="" class="hibiscus hibiscus--commander">

        <div class="commander__grille">
            <div>
                <div class="surtitre">Commander</div>
                <h2 class="titre-section titre-section--petit">Sur-mesure &amp; sur demande</h2>
                <p class="commander__texte">Dites-nous votre coloris, votre taille et l'occasion — mariage, naissance, cadeau. Nous confirmons le délai sous 48 h.</p>
                <ul class="commander__liste">
                    <li>Tailles Havaianas, du 33/34 au 41/42</li>
                    <li>Délai de fabrication 8 à 10 jours</li>
                    <li>Livraison en main propre partout à La Réunion</li>
                </ul>
            </div>

            <div class="carte-formulaire">
                {% for message in app.flashes('sur_mesure') %}
                    <div class="flash flash--success flash--integre" role="status">{{ message }}</div>
                {% endfor %}
                {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
                    {{ form_row(form.modele) }}
                    {{ form_row(form.taille) }}
                    {{ form_row(form.message) }}
                    <div class="form-duo form-duo--egal">
                        {{ form_row(form.nom) }}
                        {{ form_row(form.email) }}
                    </div>
                    <button type="submit" class="btn btn--plein btn--large">Envoyer ma demande</button>
                {{ form_end(form) }}
            </div>
        </div>
    </section>
{% endblock %}
